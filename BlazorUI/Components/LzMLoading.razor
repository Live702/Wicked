@using MudBlazor

<MudPaper Class="d-flex flex-column align-items-center justify-content-center" Style="height: 100vh;">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.subtitle1" Class="mt-2">@Message</MudText>
</MudPaper>

@code {
    [Parameter] public string Message { get; set; } = "Loading…";
} 